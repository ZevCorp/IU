{
    "name": "iu-os",
    "version": "1.0.0",
    "description": "IÜ OS - Minimalist overlay interface with neural graph visualization",
    "main": "main.js",
    "scripts": {
        "build:browser-core": "node ../node_modules/typescript/bin/tsc -p browser-core/tsconfig.json",
        "dev": "npm run build:browser-core && electron .",
        "build": "npm run build:win",
        "build:win": "npm run build:browser-core && npm run obfuscate && electron-builder --win portable && npm run restore",
        "build:mac": "npm run build:browser-core && npm run obfuscate && electron-builder --mac && npm run restore",
        "build:dir": "npm run build:browser-core && electron-builder --win --dir",
        "dist:mac": "npm run build:browser-core && electron-builder --mac",
        "pack:mac": "npm run build:browser-core && electron-builder --mac --dir",
        "obfuscate": "node scripts/obfuscate.js",
        "restore": "node scripts/restore.js",
        "publish": "npm run build:browser-core && electron-builder --win portable --publish always",
        "test:browser-core": "npm run build:browser-core && node --test browser-core/test/*.test.js",
        "test:browser-core:integration": "npm run build:browser-core && node --test browser-core/test/*.browser.spec.js",
        "test:browser-core:all": "npm run build:browser-core && node --test browser-core/test/*.test.js browser-core/test/*.browser.spec.js",
        "test:onboarding": "node --test test/inception-onboarding.test.js",
        "test:browser-reactivity": "node --test test/browser-execution-state.test.js test/browser-step-reducer.test.js",
        "test:execution-sessions": "node --test test/execution-session-manager.test.js",
        "install": "node-gyp rebuild"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ZevCorp/IU.git"
    },
    "build": {
        "appId": "com.iu.os",
        "productName": "IU",
        "directories": {
            "output": "dist"
        },
        "files": [
            "*.js",
            "!*.config.js",
            "browser-core/dist/**/*",
            "preload.js",
            "renderer/**/*",
            "node_modules/**/*",
            "!node_modules/playwright/.local-browsers/**/*"
        ],
        "extraResources": [
            {
                "from": ".env",
                "to": ".env"
            },
            {
                "from": "ax-reader.js",
                "to": "ax-reader.js"
            },
            {
                "from": "build/Release",
                "to": "build/Release"
            },
            {
                "from": "../iu-chrome-extension",
                "to": "iu-chrome-extension"
            }
        ],
        "asar": true,
        "asarUnpack": [
            "node_modules/playwright/**/*",
            "node_modules/sharp/**/*",
            "node_modules/@img/**/*",
            "node_modules/@nut-tree-fork/**/*"
        ],
        "win": {
            "target": "portable",
            "icon": "assets/icon.ico",
            "signAndEditExecutable": false
        },
        "portable": {
            "artifactName": "${productName}-${version}-Windows.exe"
        },
        "mac": {
            "category": "public.app-category.utilities",
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "assets/icon.icns",
            "extendInfo": {
                "NSAppleEventsUsageDescription": "iü OS necesita controlar otras aplicaciones para asistencia inteligente.",
                "NSSystemAdministrationUsageDescription": "iü OS necesita permisos de administración para control de sistema.",
                "NSAccessibilityUsageDescription": "iü OS necesita permisos de Accessibility para leer y controlar elementos de interfaz."
            },
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "entitlements.mac.plist",
            "entitlementsInherit": "entitlements.mac.plist"
        },
        "publish": {
            "provider": "github",
            "owner": "ZevCorp",
            "repo": "IU"
        }
    },
    "keywords": [
        "electron",
        "overlay",
        "eye-tracking",
        "hrm"
    ],
    "author": "Felipe Maldonado",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.13.3",
        "javascript-obfuscator": "^4.1.0",
        "node-addon-api": "^8.0.0",
        "node-gyp": "^10.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.76.0",
        "@google/generative-ai": "^0.24.1",
        "@nut-tree-fork/nut-js": "^4.2.6",
        "@picovoice/porcupine-web": "^4.0.0",
        "@picovoice/web-voice-processor": "^4.0.9",
        "axios": "^1.13.4",
        "dotenv": "^17.2.3",
        "electron-updater": "^6.1.7",
        "gsap": "^3.12.0",
        "mongodb": "^7.0.0",
        "openai": "^6.17.0",
        "playwright": "^1.58.0",
        "playwright-core": "^1.58.2",
        "qrcode": "^1.5.4",
        "sharp": "^0.34.5",
        "ws": "^8.19.0"
    }
}
